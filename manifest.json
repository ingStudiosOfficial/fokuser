{
	"manifest_version": 3,
	"name": "Fokuser",
	"version": "1.0.0",
	"description": "A FOSS M3E site blocker and focus timer.",
	"icons": {
		"16": "icons/logo16.png",
		"48": "icons/logo48.png",
		"128": "icons/logo128.png"
	},
	"permissions": ["scripting", "alarms", "storage", "tabs"],
	"action": {
		"default_title": "Fokuser dashboard",
		"default_popup": "index.html"
	},
	"background": {
		"service_worker": "src/worker.ts"
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["src/scripts/block.ts"],
			"run_at": "document_start"
		}
	]
}
